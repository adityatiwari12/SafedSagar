			<td style="width:11.16%">
			<p style="text-align:center"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:16px">37</span></span></p>
			</td>
			<td style="width:11.22%">
			<p style="text-align:center"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:16px">54</span></span></p>
			</td>
			<td style="width:12.14%">
			<p style="text-align:center"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:16px">89</span></span></p>
			</td>
			<td style="width:10.42%">
			<p style="text-align:justify"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:16px">-</span></span></p>
			</td>
		</tr>
		<tr>
			<td style="width:8.54%">
			<ol start="16">
				<li>&nbsp;</li>
			</ol>
			</td>
			<td style="width:21.32%">
			<p><span style="font-family:Times New Roman,Times,serif"><span style="font-size:16px">Puducherry</span></span></p>
			</td>
			<td colspan="6" style="width:70.14%">
			<p style="text-align:center"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:16px">NIL</span></span></p>
			</td>
