.sf-menu, .sf-menu * { margin: 0px; padding: 0px; list-style: none; overflow-wrap: break-word; }

.sf-menu li { position: relative; white-space: nowrap; }

.sf-menu ul li, .sf-menu ul ul li { background: rgb(226, 127, 20); }

.sf-menu ul { position: absolute; display: none; top: 100%; left: 0px; z-index: 99; box-shadow: rgba(0, 0, 0, 0.2) 2px 2px 6px; min-width: 12em; }

