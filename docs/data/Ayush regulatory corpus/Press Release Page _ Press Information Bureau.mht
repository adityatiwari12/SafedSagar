@charset "utf-8";

html.pib-hc, html.pib-hc body { background-color: rgb(23, 23, 23) !important; background-image: none !important; color: rgb(255, 255, 255) !important; }

html.pib-hc [style*="color"], html.pib-hc [style*="COLOR"], html.pib-hc [style*="background"], html.pib-hc [style*="BACKGROUND"], html.pib-hc font[color], html.pib-hc [bgcolor] { color: rgb(255, 255, 255) !important; background-color: transparent !important; background-image: none !important; }

html.pib-hc a, html.pib-hc a[style*="color"] *, html.pib-hc [style*="color"] a, html.pib-hc font[color] a { color: rgb(255, 255, 0) !important; }

html.pib-hc table, html.pib-hc table th, html.pib-hc table td { border-color: rgb(140, 140, 140) !important; }

html.pib-hc table th { background-color: rgb(43, 43, 43) !important; }

html.pib-hc.pib-a11y-content, html.pib-hc.pib-a11y-content body { background-color: rgb(23, 23, 23) !important; background-image: none !important; color: rgb(255, 255, 255) !important; }

html.pib-hc.pib-a11y-content body * { background-color: transparent !important; background-image: none !important; color: rgb(255, 255, 255) !important; border-color: rgb(140, 140, 140) !important; }

html.pib-hc.pib-a11y-content body a, html.pib-hc.pib-a11y-content body a * { color: rgb(255, 255, 0) !important; }

html.pib-hc.pib-a11y-content body table th { background-color: rgb(43, 43, 43) !important; }

html.pib-hc.pib-a11y-content body input, html.pib-hc.pib-a11y-content body select, html.pib-hc.pib-a11y-content body textarea, html.pib-hc.pib-a11y-content body button { background-color: rgb(0, 0, 0) !important; color: rgb(255, 255, 255) !important; border: 1px solid rgb(255, 255, 0) !important; }

html.pib-hc .leftSearchArea { background: rgb(31, 31, 31) !important; border-color: rgb(74, 74, 74) !important; }

html.pib-hc .prd-side-head, html.pib-hc .prd-archive { background: rgb(43, 43, 43) !important; border-color: rgb(74, 74, 74) !important; }

html.pib-hc .prd-side-title, html.pib-hc .prd-archive-title { color: rgb(255, 255, 255) !important; }

html.pib-hc .prd-side-toggle, html.pib-hc .prd-relnav-btn { background: rgb(43, 43, 43) !important; border-color: rgb(127, 212, 204) !important; color: rgb(127, 212, 204) !important; }

html.pib-hc .prd-side-toggle:hover, html.pib-hc .prd-side-toggle:focus, html.pib-hc .prd-relnav-btn:hover, html.pib-hc .prd-relnav-btn:focus { background: rgb(127, 212, 204) !important; color: rgb(17, 17, 17) !important; }

html.pib-hc .prd-relnav-btn[aria-disabled="true"], html.pib-hc .prd-relnav-btn[aria-disabled="true"]:hover, html.pib-hc .prd-relnav-btn[aria-disabled="true"]:focus { background: rgb(31, 31, 31) !important; border-color: rgb(74, 74, 74) !important; color: rgb(154, 154, 154) !important; }

html.pib-hc .prd-relnav { border-bottom-color: rgb(74, 74, 74) !important; }

html.pib-hc .prd-relnav-count { color: rgb(213, 213, 213) !important; }

html.pib-hc .prd-rel-list h3.font104 { color: rgb(240, 168, 96) !important; border-bottom-color: rgb(63, 63, 63) !important; }

html.pib-hc .prd-rel-list .num li:hover { background: rgb(51, 51, 51) !important; }

html.pib-hc .prd-rel-list li.is-current { background: rgb(36, 66, 63) !important; box-shadow: rgb(127, 212, 204) 3px 0px 0px inset !important; }

html.pib-hc .prd-rel-list { scrollbar-color: rgb(127, 212, 204) rgb(43, 43, 43); }

html.pib-hc .prd-rel-list::-webkit-scrollbar-track { background: rgb(43, 43, 43); }

html.pib-hc .prd-rel-list::-webkit-scrollbar-thumb { background: rgb(127, 212, 204); }

html.pib-hc .prd-loading.is-on { background: rgba(23, 23, 23, 0.88) !important; }

html.pib-hc .prd-loading-text { color: rgb(255, 255, 255) !important; }

html.pib-hc input:not([type="checkbox"]):not([type="radio"]), html.pib-hc select, html.pib-hc textarea, html.pib-hc .form-control { background-color: rgb(43, 43, 43) !important; color: rgb(255, 255, 255) !important; border-color: rgb(106, 106, 106) !important; }

html.pib-hc select option { background-color: rgb(43, 43, 43) !important; color: rgb(255, 255, 255) !important; }

html.pib-hc .explainer-section h2, html.pib-hc .explainer-section .name { color: rgb(255, 255, 255) !important; }

html.pib-hc .top2explainer { background: rgb(31, 31, 31) !important; box-shadow: rgb(74, 74, 74) 0px 0px 0px 1px inset !important; }

html.pib-hc .swiper-card { background: rgb(31, 31, 31) !important; box-shadow: rgb(74, 74, 74) 0px 0px 0px 1px !important; }

html.pib-hc .swiper-navBtn::before, html.pib-hc .swiper-navBtn::after { color: rgb(127, 212, 204) !important; }

html.pib-hc .indian-emblem img { filter: invert(75%) sepia(100%) saturate(5.5); }

html.pib-hc .sitemapp li { border-color: rgb(74, 74, 74) !important; }

html.pib-hc .sitemapp li a { background: rgb(61, 61, 61) !important; color: rgb(255, 255, 255) !important; }

html.pib-hc .sitemapp li ul li, html.pib-hc .sitemapp li ul li a { background: rgb(29, 29, 29) !important; border-color: rgb(74, 74, 74) !important; }

html.pib-hc .sitemapp li ul li a { color: rgb(255, 255, 0) !important; }

html.pib-hc .sitemapp li ul li a:hover, html.pib-hc .sitemapp li ul li a:focus { background: rgb(43, 43, 43) !important; color: rgb(255, 255, 255) !important; }

html.pib-hc .photo_heading { background: rgb(45, 45, 45) !important; border-bottom-color: rgb(240, 168, 96) !important; color: rgb(255, 255, 255) !important; }

html.pib-hc .photo_heading .heading3, html.pib-hc .photo_heading .videotitle, html.pib-hc .photo_heading p { color: rgb(255, 255, 255) !important; }

html.pib-hc .photo_heading .publishdatesmall { color: rgb(240, 168, 96) !important; }

html.pib-hc .photo-gallery, html.pib-hc .photo_div img { background-color: rgba(255, 243, 243, 0.09) !important; border-color: rgb(106, 106, 106) !important; }

html.pib-hc .video_gall a:focus-visible .photo-gallery, html.pib-hc a:focus-visible > .photo-gallery { outline: rgb(255, 255, 0) solid 3px; outline-offset: 2px; }
