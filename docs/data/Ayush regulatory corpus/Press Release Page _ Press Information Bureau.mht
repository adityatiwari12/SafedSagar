@charset "utf-8";

.film-roll-badge { position: absolute; top: 82%; right: 20px; width: 230px; height: 70px; background: repeating-linear-gradient(to right, rgb(154, 35, 117) 0px, rgb(154, 35, 117) 18px, rgb(110, 43, 139) 18px, rgb(110, 43, 139) 36px); border-top: 8px solid rgb(154, 35, 117); border-bottom: 8px solid rgb(154, 35, 117); border-radius: 8px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.4) 0px 4px 12px; animation: 8s linear 0s infinite normal none running moveFilm; z-index: 10; }

.film-roll-badge::before, .film-roll-badge::after { content: ""; position: absolute; width: 100%; height: 10px; background: repeating-linear-gradient(to right, rgb(154, 35, 117) 0px, rgb(154, 35, 117) 10px, rgb(255, 255, 255) 10px, rgb(255, 255, 255) 20px); left: 0px; z-index: 2; }

.film-roll-badge::before { top: -4px; }

.film-roll-badge::after { bottom: -4px; }

.film-roll-inner { position: relative; height: 100%; display: flex; align-items: center; justify-content: center; animation: 2s ease-in-out 0s infinite normal none running flicker; }

.countdown-text { font-size: 1.3rem; font-weight: 700; color: rgb(255, 255, 255); text-shadow: rgba(255, 255, 255, 0.4) 0px 0px 6px, rgb(0, 0, 0) 0px 0px 10px; white-space: nowrap; }

@keyframes moveFilm { 
  0% { background-position: 0px 0px; }
  100% { background-position: 120px 0px; }
}

@keyframes flicker { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0.9; }
  25% { opacity: 0.95; }
  75% { opacity: 0.85; }
}

@media (max-width: 1500px) {
  .film-roll-badge { top: 68%; right: 18px; height: 65px; font-size: 0.85rem; }
  .press-section { margin-top: 35px; }
}

@media (max-width: 992px) {
  .film-roll-badge { top: 52%; right: 10px; width: 200px; height: 60px; }
}

@media (max-width: 768px) {
  .film-roll-badge { top: 56%; right: 10px; width: 124px; height: 55px; }
  .countdown-text { font-size: 0.9rem; }
}

@media (max-width: 576px) {
  .film-roll-badge { top: 59%; right: 5px; height: 50px; }
  .countdown-text { font-size: 0.85rem; }
}
