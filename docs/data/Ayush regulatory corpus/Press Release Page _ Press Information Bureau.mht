.sf-menu > li { float: left; }

.sf-menu a { position: relative; text-decoration: none; color: rgb(255, 255, 255); }

#imagelightbox-close::after, #imagelightbox-close::before, .hvr-float-shadow::before, .sf-arrows .sf-with-ul::after { position: absolute; content: ""; }

.sf-menu ul ul { top: 0px; left: 100%; }

.sf-menu { float: left; }

.sf-menu li a { padding: 12px 11px; font-family: SegoeUI; text-decoration: none; }

.sf-menu ul li { border-bottom: 1px solid rgb(255, 255, 255); }

