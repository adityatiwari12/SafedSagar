.sf-menu li a:hover { background: rgb(239, 239, 239); color: rgb(0, 0, 0); }

.sf-arrows .sf-with-ul { padding-right: 2.5em; }

.sf-arrows .sf-with-ul::after { top: 50%; right: 1em; margin-top: -3px; height: 0px; width: 0px; border-width: 5px; border-style: solid; border-color: rgba(255, 255, 255, 0.9) transparent transparent; border-image: none; }

.sf-arrows > .sfHover > .sf-with-ul::after, .sf-arrows > li:hover > .sf-with-ul::after, .sf-arrows > li > .sf-with-ul:focus::after { border-top-color: rgb(255, 255, 255); }

.sf-arrows ul .sf-with-ul::after { margin-top: -5px; margin-right: -3px; border-color: transparent transparent transparent rgba(255, 255, 255, 0.5); }

.sf-arrows ul .sfHover > .sf-with-ul::after, .sf-arrows ul li:hover > .sf-with-ul::after, .sf-arrows ul li > .sf-with-ul:focus::after { border-left-color: rgb(255, 255, 255); }

.sf-menu li:nth-child(7) a.sf-with-ul::after, .sf-menu li:nth-child(7) a.sf-with-ul:hover::after { margin-top: -3px; margin-right: -3px; border-left: 5px solid transparent; border-right: 5px solid transparent; }

@media (max-width: 768px) {
  .release_list li { width: 100% !important; }
  .sf-menu li { background-image: none; padding: 10px; width: 100%; }
  .sf-arrows .sf-with-ul::after { display: none; }
  .sf-menu ul ul { left: 0px; top: 0px; }
}

.sf-menu li:nth-child(7) ul { left: auto; right: 0px; }

.sf-menu li:nth-child(7) ul li ul { left: auto; right: 100%; }

.sf-menu li:nth-child(7) a.sf-with-ul::after { border-top: 5px solid rgb(221, 221, 221); }

.sf-menu li:nth-child(7) a.sf-with-ul:hover::after { border-top: 5px solid rgb(255, 255, 255); }

.sf-menu li:nth-child(7) ul li .sf-with-ul::after, .sf-menu li:nth-child(7) ul li .sf-with-ul:hover::after { margin-top: -5px; margin-right: -3px; border-top: 5px solid transparent !important; border-bottom: 5px solid transparent !important; border-left: 0px solid rgb(255, 255, 255) !important; }

.sf-menu li:nth-child(7) ul li .sf-with-ul::after { border-right: 5px solid rgb(221, 221, 221) !important; }

.sf-menu li:nth-child(7) ul li .sf-with-ul:hover::after { border-right: 5px solid rgb(255, 255, 255) !important; }

