.newsticker ul li { color: rgb(255, 255, 255); }

.sf-menu li a:hover { background: rgb(82, 82, 82); }

.breadcrumb { background-color: rgb(60, 60, 60); }

.search_box { background: rgb(60, 60, 60); }

.menus1 h2 { background: rgb(107, 107, 107); }

