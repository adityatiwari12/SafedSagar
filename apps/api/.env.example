# Database Configuration
DATABASE_URL=postgresql+asyncpg://ipsakti:ipsakti-dev-pwd@localhost:5432/ipsakti

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# LLM (Ollama local default; optional OpenAI-compatible cloud)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_GENERATE_MODEL=llama3.2
# Tried gpt-oss:20b (2026-09-15): too slow / unreliable JSON output on
# CPU-only hardware (67s + malformed response on a trivial prompt). If
# your machine has a real GPU it may be worth retrying - otherwise stick
# with llama3.2 or use the cloud slot below for a real quality jump.
LLM_PROVIDER=ollama
# LLM_REASONING_PROVIDER=cloud
# CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=llama-3.1-8b-instant
