# Database Configuration
DATABASE_URL=postgresql+asyncpg://ipsakti:ipsakti-dev-pwd@localhost:5432/ipsakti

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# LLM (Ollama local default; optional OpenAI-compatible cloud)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_GENERATE_MODEL=llama3.2
# Optional: use a heavier local model for the final answer only
# (classify_product/routers always stay on OLLAMA_GENERATE_MODEL - they
# need sub-second turnaround). gpt-oss:20b was tried as OLLAMA_GENERATE_MODEL
# globally and reverted (too slow for classification); it now works
# correctly here (ollama_client.py switched /api/generate -> /api/chat,
# which fixed its malformed-JSON output) but still costs ~44s+ per call on
# CPU-only hardware with no GPU - only worth it if answer quality matters
# more than latency to you.
# OLLAMA_REASONING_MODEL=gpt-oss:20b
LLM_PROVIDER=ollama
# LLM_REASONING_PROVIDER=cloud
# CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=llama-3.1-8b-instant
