# Database Configuration
DATABASE_URL=postgresql+asyncpg://ipsakti:ipsakti-dev-pwd@localhost:5432/ipsakti

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# LLM (Ollama local default; optional OpenAI-compatible cloud)
# ---------------------------------------------------------------------------
# DPDP / privacy note: with LLM_PROVIDER=cloud (or LLM_REASONING_PROVIDER=
# cloud), the user's question text and the retrieved legal/regulatory chunks
# are sent to the configured third-party endpoint (CLOUD_LLM_BASE_URL) to
# generate that answer. With the local Ollama default, nothing leaves this
# machine. Don't flip to cloud for a real user's data without knowing which
# provider that is and what their data-handling terms are.
# ---------------------------------------------------------------------------

# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_GENERATE_MODEL=llama3.2
# Optional: use a heavier local model for the final answer only
# (classify_product/routers always stay on OLLAMA_GENERATE_MODEL - they
# need sub-second turnaround). gpt-oss:20b was tried as OLLAMA_GENERATE_MODEL
# globally and reverted (too slow for classification); it now works
# correctly here (ollama_client.py switched /api/generate -> /api/chat,
# which fixed its malformed-JSON output) but still costs ~44s+ per call on
# CPU-only hardware with no GPU - only worth it if answer quality matters
# more than latency to you.
# OLLAMA_REASONING_MODEL=gpt-oss:20b

# Generation provider for every LLM call: "ollama" (default, all on-prem) or
# "cloud" (OpenAI-compatible /chat/completions endpoint - see the DPDP note
# above before flipping this in an environment with real user data).
LLM_PROVIDER=ollama
# Optional override for JUST reason_and_cite (the final-answer call, where
# quality matters most) while classify_product/condense_query/route_* stay
# on LLM_PROVIDER=ollama - the recommended way to use a cloud model at all:
# it spends cloud calls only where quality matters, and keeps the frequent,
# latency-sensitive classification calls local and free.
# LLM_REASONING_PROVIDER=cloud

# Required if LLM_PROVIDER or LLM_REASONING_PROVIDER is "cloud". Any
# OpenAI-compatible /chat/completions endpoint (Groq, OpenRouter, a hosted
# vLLM/TGI instance, etc). Example shown is Groq's - swap for your provider.
# CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
# Never commit a real key here. Set it in your local, untracked .env only.
# CLOUD_LLM_API_KEY=sk-replace-with-your-own-key
# CLOUD_LLM_MODEL=llama-3.1-8b-instant

# Some OpenAI-compatible providers reject response_format:{"type":
# "json_object"} outright. Default true sends it and auto-retries once
# without it (extracting JSON from the raw/```json-fenced text) if the
# provider rejects it. Set false to skip straight to that mode for a
# provider already known not to support strict JSON mode.
# CLOUD_LLM_JSON_MODE=true

# If a cloud call fails after its retry budget (bad/expired key, network
# drop, persistent 5xx), fall back to local Ollama for that call rather than
# erroring the whole request - a demo shouldn't die because an API key
# expired. ChatTurnResponse.answered_by.fallback_used reports when this
# fired. Set false to make a cloud failure a hard error instead.
# LLM_FALLBACK_TO_LOCAL=true
